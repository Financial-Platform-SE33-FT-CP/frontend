# Copy to .env.local for local development:  cp .env.example .env.local
#
# ===== PRODUCTION (behind nginx proxy) =====
# Leave all NEXT_PUBLIC_* vars UNSET — the code defaults to relative paths
# like /api/auth, /api/tenants, etc. that go through the nginx proxy on the
# same origin.  No CORS issues, no leaked ports.
#
# ===== LOCAL DEVELOPMENT =====
# Uncomment and set these to talk directly to backend services.

# Auth service — paths like /auth/login (port 8001)
# NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001

# Tenant service — company list & workspace (port 8002)
# NEXT_PUBLIC_TENANT_SERVICE_URL=http://localhost:8002

# Ledger service — trial balance, account ledger (port 8003)
# NEXT_PUBLIC_LEDGER_SERVICE_URL=http://localhost:8003

# COA service — chart of accounts (port 8004)
# NEXT_PUBLIC_COA_SERVICE_URL=http://localhost:8003

# AR/AP service — customers & invoices (US-8)
# NEXT_PUBLIC_AR_AP_SERVICE_URL=http://localhost:8005
# PDF download (US-8) — enabled by default; set false to hide Download PDF buttons
# NEXT_PUBLIC_INVOICE_PDF_ENABLED=false

# Generic API fallback (only used by a few calls)
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Legacy aliases (optional) ---
# NEXT_PUBLIC_AUTH_URL=http://localhost:8001
# NEXT_PUBLIC_LEDGER_URL=http://localhost:8003
# NEXT_PUBLIC_COA_API_URL=http://localhost:8003
