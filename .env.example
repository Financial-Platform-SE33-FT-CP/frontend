# Tenant service URL for browser calls (no trailing slash required)
NEXT_PUBLIC_TENANT_SERVICE_URL=http://localhost:8002

# Auth service — paths like /auth/login. Defaults to 8001 for local uvicorn.
# Prefer NEXT_PUBLIC_AUTH_SERVICE_URL (aligned with tenant-service naming).
# NEXT_PUBLIC_AUTH_URL is supported for older configs.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001

# Shared API base (src/lib/api.ts) when calling through one gateway port.
NEXT_PUBLIC_API_URL=http://localhost:8000
