# Copy to .env.local for local development:  cp .env.example .env.local

# Auth service — paths like /auth/login (port 8001)
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
# Legacy alias (optional)
# NEXT_PUBLIC_AUTH_URL=http://localhost:8001

# Tenant service — company list & workspace (port 8002)
NEXT_PUBLIC_TENANT_SERVICE_URL=http://localhost:8002

# US-6 Ledger & trial balance — ledger-service (port 8003)
#   GET /ledger/trial-balance
#   GET /ledger/accounts/{account_id}/transactions
NEXT_PUBLIC_LEDGER_SERVICE_URL=http://localhost:8003

# US-6 account picker on General ledger page — coa-service (port 8004)
#   GET /coa/accounts
NEXT_PUBLIC_COA_SERVICE_URL=http://localhost:8004

# Optional gateway (src/lib/api.ts) when all routes are behind nginx on one port
NEXT_PUBLIC_API_URL=http://localhost:8000
